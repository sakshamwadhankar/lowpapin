<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Interventions (intention requests and exit prompts) are delivered as notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Heads-up/full-screen intention capture when a tracked app is opened. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Optional usage-pattern analysis (app open counts, foreground time). Special access
         granted by the user in system settings; the app degrades gracefully without it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LowpapinApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lowpapin"
        android:enableOnBackInvokedCallback="true">

        <service
            android:name=".accessibility.LowpapinBlockAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name="com.lowpapin.app.ui.MainActivity"
            android:theme="@style/Theme.Lowpapin"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.lowpapin.app.intention.IntentCaptureActivity"
            android:theme="@style/Theme.Lowpapin.Translucent"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="false" />

        <receiver
            android:name="com.lowpapin.app.intention.InterventionActionReceiver"
            android:exported="false" />
    </application>
</manifest>
